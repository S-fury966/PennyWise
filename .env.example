# ============================================================================
# Environment Variables — AI Finance Controller
# ============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# DO NOT commit .env to version control — it contains real credentials.
# ============================================================================

# Groq API key for LLM-based explanations (required).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for explanations (required).
# Default: qwen/qwen3.8-27b
GROQ_MODEL=qwen/qwen3.8-27b
